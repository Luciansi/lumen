---

import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/server-i18n";
import { getTagList } from "../../utils/content-utils";
import { getTagUrl } from "../../utils/url-utils";
import ButtonTag from "../control/ButtonTag.astro";
import WidgetLayout from "./WidgetLayout.astro";

const tags = await getTagList();

const COLLAPSED_HEIGHT = "7.5rem";

const isCollapsed = tags.length >= 20;

interface Props {
	/** 覆盖默认 i18n 标题（主页总览传中文「标签」） */
	title?: string;
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
const widgetName = Astro.props.title ?? i18n(I18nKey.tags);
---
<WidgetLayout name={widgetName} id="tags" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT} class={className} style={style}>
    <div class="flex gap-2 flex-wrap">
        {tags.map(t => (
            <ButtonTag href={getTagUrl(t.name)} label={`View all notes with the ${t.name.trim()} tag`}>
                {t.name.trim()}
            </ButtonTag>
        ))}
    </div>
</WidgetLayout>