---
// 个人卡：个人身份占主（头像/名字/一句话 + 社交），4 项统计一行排开。
// 统计在组件内自行计算（全站一致），故可被主页与经典侧栏共用。
import { Icon } from "astro-icon/components";
import {
	getCategoryList,
	getOverviewEntries,
	getTagList,
	getTotalWords,
} from "../../utils/content-utils";
import { getProfileConfig, getSiteMdConfig } from "../../utils/site-config";
import ImageWrapper from "../misc/ImageWrapper.astro";

interface Props {
	class?: string;
}
const className = Astro.props.class;
const profileConfig = getProfileConfig();
const homeIndex = getSiteMdConfig();
const config = profileConfig;
const hasAvatar = !!config.avatar;
const tagline = homeIndex.profile.tagline || homeIndex.site.subtitle;
const socials = config.links ?? [];
const nameInitial = (config.name || "L").trim().charAt(0) || "L";

const overview = await getOverviewEntries();
const categories = await getCategoryList();
const tags = await getTagList();
const total = overview.length;
const categoriesCount = categories.length;
const tagsCount = tags.length;
const words = await getTotalWords();
const wordsLabel =
	words >= 1000 ? `${(words / 1000).toFixed(1)}k` : String(words);
const ui = homeIndex.ui;
---

<div class:list={["card-base hero relative overflow-hidden text-center", className]}>
	<div class="hero-bg" aria-hidden="true"></div>

	<div class="relative flex flex-col items-center px-5 pb-4 pt-6">
		<!-- 主身份区：大头像 + 名字 + 一句话 -->
		{hasAvatar ? (
			<ImageWrapper
				src={config.avatar!}
				alt={config.name}
				class="mx-auto h-[4.4rem] w-[4.4rem] shrink-0 rounded-[1.1rem] shadow-lg"
			></ImageWrapper>
		) : (
			<div class="avatar-mono" aria-hidden="true">{nameInitial}</div>
		)}

		<h1 class="hero-title mx-auto mt-2.5 mb-0">
			{config.name}<span class="text-(--primary)">.</span>
		</h1>
		{tagline && (
			<p class="hero-tag mx-auto mt-1 mb-0 text-neutral-500 dark:text-neutral-400">{tagline}</p>
		)}

		<!-- 社交小按钮 -->
		<div class="mt-3 flex justify-center gap-2">
			{socials.map((item) => (
				<a
					rel="me"
					aria-label={item.name}
					href={item.url}
					target="_blank"
					class="btn-regular flex h-7 w-7 items-center justify-center rounded-lg active:scale-90"
				>
					<Icon name={item.icon} class="text-[0.95rem]"></Icon>
				</a>
			))}
		</div>
	</div>

	<!-- 底部细带：4 项统计一行排开 -->
	<div class="hero-stats relative border-t border-dashed border-black/10 px-4 py-2.5 dark:border-white/15">
		<div class="stat">
			<b id="ov-hero-total">{total}</b><span>{ui.statArticles}</span>
		</div>
		<div class="stat">
			<b id="ov-hero-words">{wordsLabel}</b><span>{ui.statWords}</span>
		</div>
		<div class="stat">
			<b>{categoriesCount}</b><span>{ui.statCategories}</span>
		</div>
		<div class="stat">
			<b>{tagsCount}</b><span>{ui.statTags}</span>
		</div>
	</div>
</div>

<style>
	.hero {
		container-type: inline-size;
	}
	.hero-bg::before,
	.hero-bg::after {
		content: "";
		position: absolute;
		pointer-events: none;
		filter: blur(6px);
	}
	.hero-bg::before {
		width: min(24rem, 95%);
		height: min(22rem, 85%);
		top: -48%;
		left: -16%;
		background: radial-gradient(
			closest-side,
			oklch(0.9 0.06 var(--hue) / 0.5),
			transparent 72%
		);
	}
	.hero-bg::after {
		width: min(21rem, 90%);
		height: min(19rem, 80%);
		right: -14%;
		bottom: -60%;
		background: radial-gradient(
			closest-side,
			oklch(0.93 0.04 var(--hue) / 0.45),
			transparent 72%
		);
	}
	:global(.dark) .hero-bg::before {
		background: radial-gradient(
			closest-side,
			oklch(0.5 0.12 var(--hue) / 0.38),
			transparent 72%
		);
	}
	:global(.dark) .hero-bg::after {
		background: radial-gradient(
			closest-side,
			oklch(0.42 0.1 var(--hue) / 0.32),
			transparent 72%
		);
	}

	.avatar-mono {
		width: 4.4rem;
		height: 4.4rem;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: center;
		flex: none;
		border-radius: 1.1rem;
		font-size: 2rem;
		font-weight: 800;
		color: #fff;
		background: linear-gradient(
			135deg,
			oklch(0.85 0.12 var(--hue)),
			var(--primary) 70%
		);
		box-shadow: 0 12px 28px -12px oklch(0.55 0.16 var(--hue) / 0.7);
		user-select: none;
	}

	.hero-title {
		font-size: clamp(1.7rem, 12cqw, 2.9rem);
		line-height: 1.18;
		letter-spacing: 0.01em;
		overflow-wrap: break-word;
		color: var(--text-strong);
	}
	.hero-tag {
		font-size: 0.84rem;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	/* 底部统计带：4 项一行 */
	.hero-stats {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.5rem;
	}
	.stat {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.1rem;
		min-width: 0;
	}
	.stat b {
		font-size: 1.1rem;
		line-height: 1.1;
		color: var(--primary);
		font-variant-numeric: tabular-nums;
	}
	.stat span {
		font-size: 0.66rem;
		line-height: 1.3;
		color: var(--btn-content);
		text-align: center;
		overflow-wrap: anywhere;
	}
	@media (min-width: 768px) {
		.stat span {
			font-size: 0.72rem;
		}
		.stat b {
			font-size: 1.2rem;
		}
	}
</style>
