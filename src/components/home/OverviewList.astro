---
// 主页总览「全部文章」扁平行列表（日期在行尾右角；无分组标题，
// 原创/随笔/草稿以行内徽标区分）。过滤由页面内联脚本驱动（data-hay）。
import { Icon } from "astro-icon/components";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";
import { getSiteMdConfig } from "../../utils/site-config";

export interface OverviewRow {
	url: string;
	title: string;
	published: Date;
	draft: boolean;
	category: string | null;
	tags: string[];
	description: string;
	/** 随笔笔记（徽标显示分类名） */
	isEssay?: boolean;
	words?: number;
	minutes?: number;
}

interface Props {
	rows: OverviewRow[];
}
const { rows } = Astro.props;
const shown = rows.length;
const homeIndex = getSiteMdConfig();
const ui = homeIndex.ui;
const zh = /^zh/i.test(homeIndex.site.lang);
const uncategorizedLabel = zh ? "未分类" : "Uncategorized";
const draftLabel = zh ? "草稿" : "Draft";
const essayStarTitle = zh ? "随笔精选" : "Featured essay";

/** data-hay：小写全文，供页面内联过滤脚本匹配 */
function hay(r: OverviewRow): string {
	return [
		r.title,
		r.description,
		r.category ?? "",
		(r.tags ?? []).join(" "),
		formatDateToYYYYMMDD(r.published),
	]
		.join(" ")
		.toLowerCase();
}
---

<div class="card-base flex flex-col" data-found={ui.found}>
	<!-- 区块头：标题 + 计数 + 实时过滤 -->
	<div class="flex flex-wrap items-center gap-x-4 gap-y-2 px-5 pt-5 pb-2">
		<h2 class="ov-h2">{ui.sectionAll}</h2>
		<span id="ov-count" class="ov-count">{shown}</span>
		<div class="ov-search">
			<Icon name="material-symbols:search-rounded" class="ov-search-ic" />
			<input
				id="ov-filter"
				type="search"
				placeholder={ui.searchPlaceholder}
				aria-label={zh ? "过滤文章列表" : "Filter articles"}
				autocomplete="off"
			/>
		</div>
		<div id="ov-info" class="basis-full min-h-[1.1em] text-[0.82rem] text-black/40 dark:text-white/40" aria-live="polite"></div>
	</div>

	<!-- 行列表 -->
	<div class="px-4 pb-4">
		{rows.map((r) => (
			<a href={r.url} class:list={["ov-row group"]} data-hay={hay(r)}>
				<span class="ov-body">
					<span class="flex flex-wrap items-center gap-x-2 gap-y-1">
						<span class="ov-title">{r.title}</span>
						{r.draft ? (
							<span class="ov-badge ov-badge-draft">{draftLabel}</span>
						) : r.isEssay ? (
							<span class="ov-badge ov-badge-essay">{r.category ?? "随笔"}</span>
							<span class="ov-star" title={essayStarTitle}>✦</span>
						) : null}
					</span>
					<span class="ov-pills">
						{!r.isEssay && (
							<span class="ov-pill ov-pill-cat">
								<Icon name="material-symbols:book-2-outline-rounded" class="ov-pill-ic" />
								{r.category || uncategorizedLabel}
							</span>
						)}
						{r.tags.map((t) => (
							<span class="ov-pill">
								<Icon name="material-symbols:tag-rounded" class="ov-pill-ic" />
								{t}
							</span>
						))}
						{r.words !== undefined && (
							<span class="ov-meta">· {r.words} {ui.wordUnit} · {r.minutes} {ui.minuteUnit}</span>
						)}
					</span>
					{r.description && (
						<div class="ov-desc text-black/75 dark:text-white/85">{r.description}</div>
					)}
				</span>
				<span class="ov-date mono-text">{formatDateToYYYYMMDD(r.published)}</span>
				<span class="ov-go" aria-hidden="true">
					<Icon name="material-symbols:chevron-right-rounded" />
				</span>
			</a>
		))}
	</div>

	<!-- 无结果 -->
	<div id="ov-none" class="hidden pb-10 pt-6 text-center text-black/40 dark:text-white/40">
		<Icon name="material-symbols:search-rounded" class="mx-auto mb-2 text-4xl text-black/20 dark:text-white/20" />
		<div>{ui.noResult}</div>
	</div>
</div>

<style>
	.ov-h2 {
		position: relative;
		display: flex;
		align-items: center;
		margin: 0;
		padding-left: 0.9rem;
		font-size: 1.35rem;
		font-weight: 800;
	}
	.ov-h2::before {
		content: "";
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
		width: 0.3rem;
		height: 1.35rem;
		border-radius: 0.3rem;
		background: var(--primary);
	}
	.ov-count {
		font-size: 0.8rem;
		font-weight: 700;
		line-height: 1;
		padding: 0.35rem 0.65rem;
		border-radius: 999px;
		background: var(--btn-regular-bg);
		color: var(--btn-content);
		font-variant-numeric: tabular-nums;
	}
	.ov-search {
		position: relative;
		margin-left: auto;
		flex: 1 1 15rem;
		min-width: 10rem;
		max-width: 19rem;
	}
	.ov-search-ic {
		position: absolute;
		left: 0.75rem;
		top: 50%;
		transform: translateY(-50%);
		font-size: 1.1rem;
		color: var(--btn-content);
		opacity: 0.6;
		pointer-events: none;
	}
	.ov-search input {
		width: 100%;
		height: 2.4rem;
		padding: 0 1.4rem 0 2.35rem;
		border: 0;
		border-radius: 0.75rem;
		background: var(--btn-regular-bg);
		color: inherit;
		font: inherit;
		font-size: 0.92rem;
		outline: none;
		transition: background-color 0.15s;
	}
	.ov-search input::placeholder {
		color: var(--btn-content);
		opacity: 0.55;
	}
	.ov-search input:focus {
		background: var(--btn-regular-bg-hover);
	}
	@media (max-width: 640px) {
		.ov-search {
			flex-basis: 100%;
			max-width: none;
		}
	}

	/* 行 */
	.ov-row {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto; /* 正文在前，日期在行尾右角 */
		gap: 0.4rem 1.2rem;
		padding: 0.8rem 3.4rem 0.8rem 0.9rem; /* 右侧 3.4rem 为悬浮箭头预留 */
		border-radius: 0.9rem;
		transition: background-color 0.15s;
	}
	.ov-row + .ov-row {
		border-top: 1px dashed var(--line-divider, oklch(0.9 0.005 var(--hue)));
	}
	.ov-row[hidden] {
		display: none;
	}
	.ov-row:hover {
		background: var(--btn-plain-bg-hover);
	}
	.ov-body {
		min-width: 0;
	}
	.ov-title {
		font-weight: 700;
		font-size: 1rem;
		color: inherit;
		transition: color 0.15s;
	}
	.ov-row:hover .ov-title {
		color: var(--primary);
	}
	.ov-date {
		padding-top: 0.32rem;
		font-size: 0.84rem;
		color: var(--btn-content);
		opacity: 0.6;
		white-space: nowrap;
		text-align: right;
		align-self: start;
	}
	.mono-text {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
	}
	.ov-badge {
		display: inline-flex;
		align-items: center;
		font-size: 0.68rem;
		font-weight: 700;
		line-height: 1;
		padding: 0.22rem 0.45rem;
		border-radius: 0.45rem;
		white-space: nowrap;
	}
	.ov-star {
		font-size: 0.72rem;
		line-height: 1;
		color: var(--primary);
		font-weight: 700;
	}
	.ov-badge-essay {
		border: 1px solid var(--primary);
		color: var(--primary);
		background: transparent;
	}
	.ov-badge-draft {
		background: var(--btn-regular-bg);
		color: var(--btn-content);
		border: 1px dashed var(--line-divider, oklch(0.85 0.01 var(--hue)));
		opacity: 0.8;
	}
	.ov-pills {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.32rem;
	}
	.ov-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.72rem;
		font-weight: 600;
		padding: 0.14rem 0.5rem;
		border-radius: 0.5rem;
		background: var(--btn-regular-bg);
		color: var(--btn-content);
		white-space: nowrap;
	}
	.ov-pill-cat {
		background: color-mix(in oklch, var(--primary) 11%, transparent);
		color: var(--primary);
		outline: 1px solid color-mix(in oklch, var(--primary) 30%, transparent);
	}
	.ov-pill-ic {
		font-size: 0.85rem;
		opacity: 0.85;
	}
	.ov-meta {
		margin-left: 0.2rem;
		font-size: 0.78rem;
		color: var(--btn-content);
		opacity: 0.7;
	}
	.ov-desc {
		margin-top: 0.32rem;
		font-size: 0.9rem;
		overflow: hidden;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
	}
	.ov-go {
		position: absolute;
		right: 0.7rem;
		top: 50%;
		transform: translateY(-50%) translateX(-0.4rem);
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.3rem;
		height: 2.3rem;
		border-radius: 0.7rem;
		font-size: 1.7rem;
		background: var(--btn-regular-bg);
		color: var(--primary);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.18s, transform 0.18s;
	}
	.ov-row:hover .ov-go {
		opacity: 1;
		transform: translateY(-50%) translateX(0);
	}
	@media (hover: none) {
		.ov-go {
			display: none;
		}
	}
	@media (max-width: 767px) {
		.ov-row {
			padding: 0.75rem 0.9rem 0.75rem 0.7rem;
		}
		.ov-date {
			font-size: 0.76rem;
		}
	}
</style>
